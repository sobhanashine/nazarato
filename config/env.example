# Copy to .env.local; enter real values locally, never commit them.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
# Optional integrations. Real SMS login requires explicitly enabled staging.
OTP_HASH_SECRET=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
GEMINI_API_KEY=
# Select a model available to the supplied key before enabling real AI traffic.
GEMINI_MODEL=gemini-2.5-flash
WP_API_URL=
# The server passes the public VAPID key to the UI at request time.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_SMFLOW_ENABLED=false
# Private loopback-only preview: requires an ignored, separately supplied file.
NAZARATO_LOCAL_PREVIEW=false
# Actual built revision; do not use a fabricated SHA.
RELEASE_SHA=
# Staging: the founder approved sharing the exact main project on 2026-10-15.
# Production stays on the defaults when these flags are absent.
# NEXT_PUBLIC_NAZARATO_ENV=staging
# NAZARATO_DEPLOYMENT_ENV=staging
# NAZARATO_SMS_ENABLED=false
# NAZARATO_STAGING_DATABASE_MODE=shared-main
# NAZARATO_STAGING_SUPABASE_REF=sdlmjdxrfyhuiegjysac
# Default isolated mode still requires a separate project and rejects main.
