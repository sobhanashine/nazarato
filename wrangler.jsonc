{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nazarato",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    { "pattern": "nazarato.ir", "custom_domain": true },
    { "pattern": "www.nazarato.ir", "custom_domain": true }
  ],
  "alias": {
    "./next-env.mjs": "./cloudflare/runtime-env.mjs"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "nazarato-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.nazarato.ir", "custom_domain": true }],
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "d1_databases": [{
        "binding": "STAGING_SERVICES",
        "database_name": "nazarato-staging-services",
        "database_id": "5fbc8f41-101a-4e7d-ad70-bfc482c719ef",
        "migrations_dir": "cloudflare/migrations"
      }],
      "vars": {
        "NEXT_PUBLIC_NAZARATO_ENV": "staging",
        "NAZARATO_DEPLOYMENT_ENV": "staging",
        "NAZARATO_STAGING_DATABASE_MODE": "shared-main",
        "NAZARATO_DATABASE_SCHEMA": "nazarato_staging",
        "NAZARATO_STAGING_SUPABASE_REF": "sdlmjdxrfyhuiegjysac",
        "NAZARATO_SMS_ENABLED": "false",
        "NEXT_PUBLIC_SMFLOW_ENABLED": "false"
      }
    }
  }
}
